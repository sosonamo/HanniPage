# Google Cloud Console에서 Calendar API를 활성화하고, 공개 캘린더 ID와
# HTTP 리퍼러 제한을 건 API 키를 입력하세요. VITE_ 값은 브라우저에 노출됩니다.
VITE_GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
VITE_GOOGLE_CALENDAR_API_KEY=your_restricted_api_key

# 선택 설정
VITE_CALENDAR_TIME_ZONE=Asia/Seoul
VITE_GOOGLE_CALENDAR_MAX_RESULTS=50

# Firebase 콘솔 > 프로젝트 설정 > 웹 앱의 firebaseConfig 값 (공개 클라이언트 설정)
# 서비스 계정 비공개 키를 VITE_ 변수에 넣지 마세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
